# Copy to .env. Keep real values out of version control.
LISTEN_ADDR=:8080
METRICS_ADDR=:9090
DATABASE_URL=sqlite:///data/apartments.db

# Flipify v1 — keep the initial five-minute cadence until /account/credits and
# /account/usage confirm a lower interval fits the account allowance.
FLIPIFY_API_KEY=
FLIPIFY_BASE_URL=https://api.flipify.com/v1
FLIPIFY_QUERY=apartments / housing for rent
FLIPIFY_LATITUDE=37.7749
FLIPIFY_LONGITUDE=-122.4194
FLIPIFY_POLL_INTERVAL=5m

# Google Vision. Supply either an API key or a service-account path.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
VISION_MONTHLY_IMAGE_CAP=999

# The sidecar is optional during local development, but production uses it.
INFERENCE_ADDRESS=inference-sidecar:50051

# Deterministic user preferences and risk gates.
QUALIFIED_MAX_FRAUD_SCORE=0.50
URGENT_MAX_FRAUD_SCORE=0.20
URGENT_MIN_FIT_SCORE=0.80
PREFERRED_MIN_PRICE=2000
PREFERRED_MAX_PRICE=3500
PREFERRED_MIN_BEDROOMS=1
PREFERRED_LOCATIONS=mission,soma,sunset

# Optional market-comps provider (intentionally unused in the MVP core).
BATCH_DATA_API_KEY=

# Resend digest: every qualified listing, no contact details or description.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
NOTIFICATION_EMAIL_FROM=alerts@example.com
NOTIFICATION_EMAIL_TO=you@example.com
RESEND_DIGEST_INTERVAL=12h

# Telegram: only strict urgent matches.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GRAFANA_PASSWORD=change-me-before-exposure
HTTP_TIMEOUT=10s
